  users {
    int id PK
    varchar username
    varchar role
    varchar status
    varchar phone
    varchar license_path
  }
  resumes {
    int id PK
    int user_id FK
    varchar skills
    varchar visibility
    int is_default
    varchar attachment_path
  }
  jobs {
    int id PK
    int company_id FK
    varchar title
    int salary_min
    varchar job_type
    varchar status
    int is_top
  }
  applications {
    int id PK
    int job_id FK
    int seeker_id FK
    varchar status
    int match_score
    int apply_count
    tinyint deleted
  }
  interviews {
    int id PK
    int application_id FK
    datetime scheduled_at
    varchar status
  }
