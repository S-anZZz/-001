# 环境变量示例：复制成 .env 或直接配置到部署平台
# 本地默认值写在 db.js 里（root / 808080 / add_work），本地开发可以不配任何变量

# ---------- 数据库 ----------
DB_HOST=127.0.0.1        # 数据库主机，云数据库填控制台给出的地址
DB_PORT=3306             # 端口，本地 MySQL 是 3306，TiDB Cloud 是 4000
DB_USER=root             # 用户名，TiDB Cloud 形如 xxxxx.root
DB_PASSWORD=808080       # 密码
DB_NAME=add_work         # 库名，应用会自动创建
DB_SSL=false             # 云数据库必须为 true（强制 TLS 1.2+）

# ---------- 上传文件存储 ----------
FILE_STORAGE=disk        # disk=写本地 uploads 目录；db=存进 files 表（PaaS 上必须用 db）

# ---------- 服务端口 ----------
PORT=3000                # 监听端口，部署平台会自动注入，无需手动设置
